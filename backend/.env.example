# Environment configuration
NODE_ENV=development

# Domain
DOMAIN_URL=https://mirada-backend.overzoom.it

# Server
HOST=0.0.0.0
PORT=5000
TIMEZONE=Europe/Berlin

# Auth
JWT_SECRET=Channge_ME
SALT_ROUNDS=12

# DATABASE CONFIG
DATABASE_URL="postgresql://user:password@localhost:5432/mirada-backend?schema=public&connection_limit=1"

GOD_USERNAME=god
GOD_PASSWORD=god

# GOOGLE API KEY
GOOGLE_API_KEY=


SEED_DB=false

# ── Firma dei QR dei biglietti — backend-brief §4.12, assunzione AS-7 ─────────
# Chiave privata Ed25519 in PKCS#8 DER, codificata base64 (una sola riga).
# Generala con:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# In assenza, il backend ne genera una EFFIMERA all'avvio e lo dichiara nel log:
# i QR emessi non sopravvivono al riavvio del processo. Accettabile in sviluppo,
# mai in produzione.
QR_SIGNING_KEY_ID=
QR_SIGNING_PRIVATE_KEY=

# ── Accesso tramite fornitore di identità (Authentik) — fase 3 ───────────────
# In assenza di QUESTE DUE righe l'SSO è semplicemente spento: `GET /auth/sso/config`
# risponde `enabled: false` e la pagina di accesso mostra il solo form con utente
# e password. Non è un guasto ed è la configurazione giusta in sviluppo, finché
# non si ha un Authentik a cui parlare.
#
# ⚠️ L'issuer è quello dell'APPLICAZIONE, non la radice del dominio: Authentik ne
# emette uno per provider (`issuer_mode: per_provider`). Lo si legge dal documento
# di scoperta, e deve terminare con lo slash.
#
#   produzione: https://auth.mirada.dance/application/o/mirada-backoffice/
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Facoltativo. `offline_access` serve solo se un giorno si vorrà il refresh token
# del fornitore: oggi la sessione è il JWT di mirada e non se ne fa nulla.
OIDC_SCOPE=openid profile email

# ── La porta dell'accesso con utente e password ─────────────────────────────
#   on         tutti (PREDEFINITO)
#   god-only   solo chi ha il ruolo GOD — la chiave d'emergenza
#   off        nessuno: si entra solo dal fornitore di identità
#
# ⚠️ Un valore non riconosciuto vale `on`, NON `off`: un refuso non deve poter
# chiudere fuori lo staff. L'errore viene però urlato nel log.
PASSWORD_LOGIN=on
