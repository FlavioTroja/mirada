generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["fullTextSearchPostgres"]
}

generator zod {
  provider                         = "zod-prisma-types"
  output                           = "./generated/zod"
  useMultipleFiles                 = true
  createOptionalDefaultValuesTypes = true
  createPartialTypes               = true
  createInputTypes                 = false
  addInputTypeValidation           = false
  createRelationValuesTypes        = true
  writeNullishInModelTypes         = true
}

datasource db {
  provider = "postgresql"
}

/// Ruoli di piattaforma (backend-brief §1.3 / §3.8).
/// GOD è allow-all implicito (vedi hasPermission) e non è mai un ruolo dell'interfaccia.
///
/// ATTENZIONE — ADMIN e USER NON appartengono al dominio Mirada Tango.
/// Restano nell'enum solo perché il seed di serie del template li usa
/// (prisma/seed-data/seed_users.ts assegna ADMIN/USER agli utenti di sviluppo e
/// Log.toRoles ha default [ADMIN, USER]): rimuoverli romperebbe il seed e il modello Log.
/// Non hanno e non devono avere ALCUNA riga in PermissionConfig: nessun permesso,
/// in nessuno scope. Ogni concessione del progetto vive sui cinque ruoli del §3.8.
enum RoleName {
  GOD
  ADMIN // legacy template — nessun permesso concesso
  USER // legacy template — nessun permesso concesso
  OWNER
  EVENT_MANAGER
  CHECKIN_OPERATOR
  DANCER
}

enum UiScope {
  EDITABLE
  VISIBLE
  INVISIBLE
}

enum ValueType {
  float
  integer
  string
  boolean
  json
}

enum Level {
  INFO
  WARNING
  ERROR
}

enum Gender {
  M
  F
  OTHER
}

enum PersonType {
  USER
}

model User {
  id        Int     @id @default(autoincrement())
  username  String  @unique
  password  String
  wsCode    String?
  avatarUrl String?
  note      String?

  enabled     Boolean   @default(true) // sospensione account (gate login)
  activatedAt DateTime? // "valido da"; null = nessun vincolo di inizio
  expiresAt   DateTime? // scadenza; null = nessuna scadenza

  /// Quando il proprietario dell'indirizzo ha premuto il tasto nell'email di
  /// conferma. **Nullo = mai confermato**, e l'accesso è rifiutato con
  /// `EMAIL_NOT_CONFIRMED`.
  ///
  /// Serve un campo suo e non `enabled`: `enabled` è la sospensione decisa da
  /// un amministratore, questo è «l'indirizzo non è ancora stato dimostrato».
  /// Confonderli darebbe a chi si è appena iscritto il messaggio «account
  /// disabilitato» — che è falso e non dice cosa fare.
  ///
  /// È anche ciò che rende il link di conferma **usabile una volta sola in
  /// modo utile**: al secondo clic il campo è già valorizzato e la risposta
  /// diventa «già confermato, entra pure» invece di un errore.
  emailVerifiedAt DateTime?

  /// L'identità su Authentik — il `sub` del token OIDC — quando l'utente
  /// accede tramite il fornitore di identità invece che con la password.
  ///
  /// **È il `sub` e non l'email di proposito.** L'email cambia: una persona
  /// passa da un indirizzo personale a uno dell'organizzazione, e nel
  /// frattempo il vecchio indirizzo può essere riassegnato a qualcun altro.
  /// Il `sub` è un UUID che Authentik non riusa e che non cambia nemmeno
  /// rinominando l'utente (`sub_mode: user_uuid` sul provider). Legare
  /// l'identità all'email significherebbe che cambiare indirizzo equivale a
  /// cambiare persona — o, peggio, che riassegnarlo equivale a cedere
  /// l'account.
  ///
  /// Nullo per chi non è mai passato dall'SSO: l'accesso con utente e
  /// password resta attivo, quindi le due strade convivono. Si valorizza al
  /// primo accesso SSO, agganciando l'utenza esistente (§SsoService).
  authentikSub String? @unique

  logoFileId Int?
  logoFile   File? @relation("UserLogo", fields: [logoFileId], references: [id], onDelete: SetNull)

  personId Int          @unique
  person   Person       @relation(fields: [personId], references: [id])
  roles    RoleToUser[]
  logs     Log[]

  dancerProfile           DancerProfile?
  organizationMemberships OrganizationMember[]
  invitationsSent         OrganizationInvitation[] @relation("OrganizationInvitationInvitedBy")
  invitationsAccepted     OrganizationInvitation[] @relation("OrganizationInvitationAcceptedBy")
  fiscalDeclarations      FiscalDeclaration[]      @relation("FiscalDeclarationDeclaredBy")
  registrations           Registration[]           @relation("RegistrationPerson")
  guardedRegistrations    Registration[]           @relation("RegistrationGuardian")

  // Fase D1 — passi 17, 23→26 (più i gusci 18→22 del checkout).
  reviewedRequirementOutcomes RequirementOutcome[] @relation("RequirementOutcomeReviewer")
  purchases                   Purchase[]           @relation("PurchaseBuyer")
  reservations                Reservation[]        @relation("ReservationUser")
  passIssuances               PassIssuance[]       @relation("PassIssuanceIssuedBy")
  ticketTransfersFrom         TicketTransfer[]     @relation("TicketTransferFrom")
  ticketTransfersTo           TicketTransfer[]     @relation("TicketTransferTo")
  checkIns                    CheckIn[]            @relation("CheckInOperator")

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PermissionConfig {
  id       Int      @id @default(autoincrement())
  roleName RoleName
  role     Role     @relation(fields: [roleName], references: [name], onDelete: Cascade)
  action   String
  entity   String
  scope    String

  @@unique([action, entity, scope, roleName])
  @@index([action, entity, scope])
}

model HiddenComponentConfig {
  id        Int      @id @default(autoincrement())
  roleName  RoleName
  role      Role     @relation(fields: [roleName], references: [name], onDelete: Cascade)
  context   String
  section   String
  component String
  isActive  Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([context, section, component, roleName])
  @@index([context, section, component])
}

model Role {
  name                   RoleName                @id
  label                  String?
  rank                   Float
  isActive               Boolean?                @default(true)
  users                  RoleToUser[]
  permissionConfigs      PermissionConfig[]
  hiddenComponentConfigs HiddenComponentConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleToUser {
  id       Int      @id @default(autoincrement())
  roleName RoleName
  userId   Int
  role     Role     @relation(fields: [roleName], references: [name], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleName, userId])
}

model Log {
  id               Int        @id @default(autoincrement())
  level            Level      @default(INFO)
  description      String?
  entityId         Int?
  entityName       String?
  input            Json?
  output           Json?
  toRoles          RoleName[] @default([ADMIN, USER])
  actionByUsername String?
  actionById       Int?
  actionBy         User?      @relation(fields: [actionById], references: [id], onDelete: SetNull)
  isNotification   Boolean?   @default(false)
  hasError         Boolean?   @default(false)
  createdAt        DateTime   @default(now())

  recipients Json?
}

model Config {
  name      String    @id
  scope     String
  uiScope   UiScope   @default(INVISIBLE)
  type      ValueType @default(boolean)
  boolean   Boolean?
  integer   Int?
  float     Float?
  string    String?
  json      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Person {
  id Int @id @default(autoincrement())

  name       String
  surname    String
  birthDate  DateTime?
  fiscalCode String?
  vatNumber  String?
  gender     Gender?
  personType PersonType
  note       String?
  avatarUrl  String?

  bornIn  String? // City of birth
  livesIn String? // City of residence

  user      User?
  contactId Int          @unique
  contact   Contact      @relation(fields: [contactId], references: [id])
  addresses Address[]
  files     PersonFile[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id Int @id @default(autoincrement())

  email       String  @unique
  phoneNumber String?
  note        String?
  telephone   String?
  pec         String?

  person Person?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id       Int      @id @default(autoincrement())
  country  String?
  state    String?
  province String?
  city     String?
  zipCode  String?
  address  String?
  number   String?
  note     String?
  default  Boolean? @default(false)
  billing  Boolean? @default(false)

  /// **Non si digita** (§3.4): il servizio la deriva dalla sigla di provincia
  /// con la tabella delle province italiane (`@utils/helpers/italianProvinces`),
  /// su `create` e su `update`. Non compare in alcun DTO di scrittura.
  ///
  /// È una colonna e non un calcolo in lettura perché il filtro geografico
  /// della ricerca pubblica dev'essere una condizione INDICIZZATA, e perché un
  /// campo libero produrrebbe «Puglia», «PUGLIA» e «Apulia» come tre regioni
  /// diverse.
  region String?

  personId Int?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  organizations Organization[]
  venues        Venue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Le due colonne del filtro pubblico di `POST /api/public/events/` (§3.7):
  /// la ricerca per città e per regione passa da qui attraverso `Venue`.
  @@index([region])
  @@index([city])
}

model File {
  id Int @id @default(autoincrement())

  name     String
  path     String
  url      String @unique
  mimeType String
  size     Int

  personFiles PersonFile[]
  userLogos   User[]       @relation("UserLogo")

  organizationLogos   Organization[]  @relation("OrganizationLogo")
  dancerProfileAvatar DancerProfile[] @relation("DancerProfileAvatar")
  artistPhotos        Artist[]        @relation("ArtistPhoto")

  eventPostersVertical   Event[] @relation("EventPosterVertical")
  eventPostersHorizontal Event[] @relation("EventPosterHorizontal")
  eventPostersSquare     Event[] @relation("EventPosterSquare")

  ticketPdfs Ticket[] @relation("TicketPdf")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PersonFile {
  personId Int
  fileId   Int

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([personId, fileId])
  @@index([fileId])
}

// =============================================================================
// Mirada Tango — Fase A (backend-brief §2 passi 1→6)
// Enumerazioni: sottoinsieme del §3.5 usato dalle entità di fase A.
// =============================================================================

enum OrganizationStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum PayoutStatus {
  NOT_CONNECTED
  PENDING
  ENABLED
  DISABLED
}

enum OrgMemberRole {
  OWNER
  EVENT_MANAGER
  CHECKIN_OPERATOR
}

enum PreferredDanceRole {
  LEADER
  FOLLOWER
  BOTH
}

enum ArtistKind {
  TEACHER
  DJ
  ORCHESTRA
}

enum RequirementKind {
  DECLARATION
  CUSTOM_FIELD
}

// -----------------------------------------------------------------------------
// Passo 1 — cataloghi di piattaforma (§4.1). Scrittura riservata a GOD.
// -----------------------------------------------------------------------------

model EventType {
  id Int @id @default(autoincrement())

  /// I18nText { it, en? }
  name Json
  slug String @unique

  /// Le cinque capacità generano il wizard di creazione evento (§4.1).
  capMultiSession Boolean @default(false)
  capRoleQuotas   Boolean @default(false)
  capLevels       Boolean @default(false)
  capCast         Boolean @default(false)
  capCouple       Boolean @default(false)

  defaultTemplate Json    @default("{}")
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  events Event[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model RequirementType {
  id Int @id @default(autoincrement())

  /// I18nText { it, en? }
  name         Json
  kind         RequirementKind
  configSchema Json            @default("{}")
  active       Boolean         @default(true)

  eventRequirements EventRequirement[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([kind])
}

model ServiceType {
  id Int @id @default(autoincrement())

  /// I18nText { it, en? }
  name             Json
  attributesSchema Json    @default("{}")
  active           Boolean @default(true)

  eventServices EventService[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// -----------------------------------------------------------------------------
// Passo 2 — Organization (§4.2)
// -----------------------------------------------------------------------------

model Organization {
  id Int @id @default(autoincrement())

  name String

  /// ⚠️ Ragione sociale e forma giuridica sono **facoltative alla nascita** e
  /// obbligatorie **prima di pubblicare** (`EventService.publish`).
  ///
  /// Da quando un organizzatore può aprirsi l'organizzazione da solo, questi
  /// campi non possono più essere pretesi all'apertura: chi si iscrive la sera
  /// per provare la piattaforma non ha sottomano la visura, e un modulo che
  /// chiede la forma giuridica al primo passo è un modulo che nessuno finisce.
  /// Il dato serve quando serve davvero — cioè quando si comincia a vendere
  /// biglietti e a emettere documenti fiscali.
  legalName String?
  legalForm String?
  vatNumber String?
  taxCode   String?

  addressId Int?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  contactEmail String
  contactPhone String?
  website      String?

  status OrganizationStatus @default(PENDING)

  /// Calcolati dal server a partire da Stripe — mai accettati dal client (§4.2, §5).
  stripeAccountId String?      @unique
  payoutStatus    PayoutStatus @default(NOT_CONNECTED)
  payoutCheckedAt DateTime?

  termsVersion    String?
  termsAcceptedAt DateTime?

  logoFileId Int?
  logoFile   File? @relation("OrganizationLogo", fields: [logoFileId], references: [id], onDelete: SetNull)

  members            OrganizationMember[]
  invitations        OrganizationInvitation[]
  orders             Order[]
  venues             Venue[]
  artists            Artist[]
  refundPolicies     RefundPolicy[]
  events             Event[]
  fiscalDeclarations FiscalDeclaration[]
  salesChannels      SalesChannel[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([payoutStatus])
}

// -----------------------------------------------------------------------------
// Passo 3 — DancerProfile (§4.3)
// -----------------------------------------------------------------------------

model DancerProfile {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  nickname      String             @unique
  preferredRole PreferredDanceRole @default(BOTH)
  city          String?
  /// `@default([])` è necessario, non cosmetico: senza, `zod-prisma-types` rende
  /// la lista OBBLIGATORIA nel DTO Create e il client dovrebbe mandare `[]` per
  /// creare un profilo senza lingue dichiarate. Stesso difetto già corretto su
  /// `Event.tags` in fase B (backend-brief §C.4).
  languages     String[]           @default([])
  birthDate     DateTime?
  declaredLevel String?

  avatarFileId Int?
  avatarFile   File? @relation("DancerProfileAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  /// Calcolati dal server dal servizio changeNickname (§4.3).
  nicknameChangedAt   DateTime?
  nicknameChangeCount Int       @default(0)

  /// Spazio riservato agli attributi di ballo estensibili di fase 2 (§4.3).
  attributes Json @default("{}")

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Passo 4 — OrganizationMember (§4.3) — risolve il contesto di tenancy (§1.5)
// -----------------------------------------------------------------------------

model OrganizationMember {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role       OrgMemberRole
  invitedAt  DateTime      @default(now())
  acceptedAt DateTime?

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId, role])
  @@index([userId])
  @@index([organizationId])
}

/// **L'invito a entrare in un'organizzazione che esiste già.**
///
/// È ciò che permette a un secondo organizzatore di raggiungere un tenant che
/// non ha aperto lui. La regola che governa tutta l'autoregistrazione è che sia
/// **il gettone a decidere se nasce un tenant**: chi arriva senza invito apre
/// un'organizzazione nuova, chi arriva con un invito valido entra in quella
/// indicata e nessuna organizzazione viene creata.
///
/// ── Perché una riga, e non un gettone firmato ────────────────────────────────
/// I link di conferma dell'email sono gettoni firmati **senza stato**
/// (`@utils/helpers/emailToken`), e lì è la scelta giusta. Qui no: un invito
/// deve poter essere **revocato** prima della scadenza, e speso **una volta
/// sola**. Una firma non sa fare né l'una né l'altra cosa — dice soltanto
/// «questo l'ho emesso io» — mentre una riga porta `revokedAt` e `acceptedAt` e
/// risponde a entrambe le domande.
model OrganizationInvitation {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// L'indirizzo a cui l'invito è stato mandato, normalizzato in minuscolo.
  ///
  /// ⚠️ Chi accetta deve autenticarsi **con questo indirizzo**. Senza il
  /// vincolo, un link inoltrato — anche solo per sbaglio, anche solo perché la
  /// casella è condivisa — regalerebbe a un estraneo il ruolo di titolare di
  /// un'organizzazione altrui.
  email String

  /// Oggi vale solo `OWNER`: si invitano altri titolari. Gli altri due ruoli si
  /// assegnano dal backoffice a chi un'utenza ce l'ha già, e non hanno bisogno
  /// di una strada d'ingresso propria.
  role OrgMemberRole @default(OWNER)

  /// **L'impronta** del gettone, non il gettone. Chi legge la banca dati non
  /// deve poter entrare in un'organizzazione: l'originale esiste solo dentro il
  /// link, cioè nella casella di posta dell'invitato.
  tokenHash String @unique

  invitedById Int
  invitedBy   User @relation("OrganizationInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  acceptedAt DateTime?

  /// Chi ha accettato. Resta anche dopo, perché «chi ha fatto entrare chi» è
  /// esattamente la domanda che ci si pone mesi più tardi.
  acceptedById Int?
  acceptedBy   User? @relation("OrganizationInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
}

// -----------------------------------------------------------------------------
// Passo 5 — Venue · Artist (§4.4)
// -----------------------------------------------------------------------------

model Venue {
  id Int @id @default(autoincrement())

  /// Null = sala di piattaforma, non appartenente ad alcuna organizzazione.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  addressId Int
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  latitude   Float?
  longitude  Float?
  /// Proposta come default alla quota di capienza della sala, mai imposta (§4.4).
  capacity   Int?
  floorNotes String?

  airConditioning Boolean @default(false)
  parking         Boolean @default(false)
  accessibility   String?
  notes           String?

  events Event[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([addressId])
}

model Artist {
  id Int @id @default(autoincrement())

  /// Null = anagrafica di piattaforma. Nessuna relazione a User: l'artista non ha account (§4.4).
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String
  kind ArtistKind

  /// I18nText { it, en? }
  bio Json?

  photoFileId Int?
  photoFile   File? @relation("ArtistPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)

  website String?

  eventCasts EventCast[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([kind])
}

// -----------------------------------------------------------------------------
// Passo 6 — RefundPolicy (§4.4)
// -----------------------------------------------------------------------------

model RefundPolicy {
  id Int @id @default(autoincrement())

  /// I18nText { it, en? }
  name Json

  /// [{ daysBefore, percent }]
  tiers Json @default("[]")

  transferDeadlineHours Int     @default(0)
  feeRefundable         Boolean @default(false)
  isPlatformPreset      Boolean @default(false)

  /// Null = preset di piattaforma.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Preset di piattaforma da cui la policy discende (emendamento B.0 al §3.6).
  /// È il termine di paragone che rende verificabile la regola del §4.4:
  /// una policy derivata può essere più favorevole al partecipante, mai più restrittiva.
  derivedFromPolicyId Int?
  derivedFromPolicy   RefundPolicy?  @relation("RefundPolicyDerivation", fields: [derivedFromPolicyId], references: [id], onDelete: SetNull)
  derivedPolicies     RefundPolicy[] @relation("RefundPolicyDerivation")

  events Event[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([isPlatformPreset])
  @@index([derivedFromPolicyId])
}

// =============================================================================
// Mirada Tango — Fase B (backend-brief §2 passi 7→12)
// =============================================================================

enum DanceRole {
  LEADER
  FOLLOWER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SALES_CLOSED
  RUNNING
  ENDED
  ARCHIVED
  CANCELLED
}

enum SalesCloseCriterion {
  DATE
  QUOTA_EXHAUSTED
  MANUAL
  EVENT_START
}

enum FiscalDeclarationKind {
  ORGANIZATION_FRAMEWORK
  EVENT_ATTESTATION
}

enum RequirementBlocking {
  PURCHASE
  ENTRY
  NONE
}

enum RequirementVerification {
  AUTOMATIC
  MANUAL
}

enum SaleUnit {
  PER_PERSON
  PER_COUPLE
}

enum TicketTypeVisibility {
  PUBLIC
  CODE_RESTRICTED
}

enum PriceTierKind {
  BY_DATE
  BY_QUANTITY
  COMBINED
}

// -----------------------------------------------------------------------------
// Passo 7 — Event (§4.5)
// -----------------------------------------------------------------------------

model Event {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  eventTypeId Int
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)

  venueId Int
  venue   Venue @relation(fields: [venueId], references: [id], onDelete: Restrict)

  /// I18nText { it, en? }
  title       Json
  /// Unico GLOBALE: è la chiave di `GET /api/public/events/:slug` (§4.5).
  slug        String @unique
  /// I18nText { it, en? }
  description Json

  startAt DateTime
  endAt   DateTime

  contentLanguage String
  secondLanguage  String?
  /// `@default([])` è necessario, non cosmetico: senza, `zod-prisma-types` rende
  /// la lista OBBLIGATORIA nel DTO Create e il client dovrebbe mandare `[]`
  /// per dire «nessun tag». L'assenza deve significare l'insieme vuoto.
  tags            String[] @default([])

  posterVerticalFileId Int?
  posterVerticalFile   File? @relation("EventPosterVertical", fields: [posterVerticalFileId], references: [id], onDelete: SetNull)

  posterHorizontalFileId Int?
  posterHorizontalFile   File? @relation("EventPosterHorizontal", fields: [posterHorizontalFileId], references: [id], onDelete: SetNull)

  posterSquareFileId Int?
  posterSquareFile   File? @relation("EventPosterSquare", fields: [posterSquareFileId], references: [id], onDelete: SetNull)

  /// Governato dalle transizioni del servizio, mai scritto dal DTO Create (§4.5).
  status EventStatus @default(DRAFT)

  refundPolicyId   Int?
  refundPolicy     RefundPolicy? @relation(fields: [refundPolicyId], references: [id], onDelete: SetNull)
  /// I18nText { it, en? }
  refundPolicyText Json          @default("{}")

  minorsAdmitted   Boolean @default(false)
  /// I18nText { it, en? }
  minorsConditions Json?

  salesCloseAt       DateTime?
  /// Vedi la nota su `tags`: l'assenza di criteri configurati è l'insieme vuoto,
  /// e `EVENT_START` resta comunque sempre attivo come ultimo (`RF-EVT-40`).
  salesCloseCriteria SalesCloseCriterion[] @default([])

  manageExternalChannels Boolean @default(false)

  publishedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  sessions           Session[]
  casts              EventCast[]
  requirements       EventRequirement[]
  services           EventService[]
  ticketTypes        TicketType[]
  fiscalDeclarations FiscalDeclaration[]
  capacityQuotas     CapacityQuota[]
  couples            Couple[]
  registrations      Registration[]
  orders             Order[]
  reservations       Reservation[]
  passIssuances      PassIssuance[]
  tickets            Ticket[]
  externalSales      ExternalSale[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([startAt])
  @@index([slug])
}

// -----------------------------------------------------------------------------
// Passo 8 — FiscalDeclaration (§4.3) — IMMUTABILE
// -----------------------------------------------------------------------------

/// Nessun `PATCH`, nessun `DELETE`: si crea una nuova versione (`RF-ORG-8`).
/// Tutte le relazioni sono `Restrict`: una dichiarazione non si perde mai per cascata.
model FiscalDeclaration {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  eventId Int?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)

  kind FiscalDeclarationKind

  /// Progressivo per (organizationId, kind, eventId) — calcolato dal servizio.
  version Int @default(1)

  frameworkLabel String
  statementText  String

  /// Calcolati dal server, mai accettati dal client (§4.3).
  declaredAt       DateTime @default(now())
  declaredByUserId Int
  declaredBy       User     @relation("FiscalDeclarationDeclaredBy", fields: [declaredByUserId], references: [id], onDelete: Restrict)
  ipAddress        String

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Regge il progressivo delle attestazioni di evento. Per le dichiarazioni di
  /// inquadramento (`eventId` nullo) Postgres considera i NULL distinti: lì il
  /// progressivo è garantito dal servizio, che calcola `max(version) + 1` in transazione.
  @@unique([organizationId, kind, eventId, version])
  @@index([organizationId, kind])
  @@index([eventId])
}

// -----------------------------------------------------------------------------
// Passo 9 — Session (§4.6)
// -----------------------------------------------------------------------------

model Session {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// I18nText { it, en? }
  name Json

  startAt DateTime
  endAt   DateTime

  room  String?
  level String?

  /// Peso di ripartizione (`RF-EVT-36`): default uniforme calcolato dal servizio.
  allocationWeight Int @default(1)

  /// Sessione implicita reale creata dal servizio quando l'EventType ha
  /// `capMultiSession = false`: il check-in di una milonga singola gira sullo
  /// stesso codice di quello di un festival (§4.6).
  isImplicit Boolean @default(false)

  cancelledAt        DateTime?
  cancellationReason String?
  sortOrder          Int       @default(0)

  ticketTypeSessions TicketTypeSession[]
  checkIns           CheckIn[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([eventId, startAt])
}

// -----------------------------------------------------------------------------
// Passo 10 — EventCast · EventRequirement · EventService (§4.6)
// -----------------------------------------------------------------------------

model EventCast {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  artistId Int
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  kind      ArtistKind
  sortOrder Int        @default(0)

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([artistId])
}

model EventRequirement {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  requirementTypeId Int
  requirementType   RequirementType @relation(fields: [requirementTypeId], references: [id], onDelete: Restrict)

  /// I18nText { it, en? }
  label Json
  /// I18nText { it, en? }
  text  Json

  mandatory    Boolean                 @default(false)
  blocking     RequirementBlocking     @default(NONE)
  verification RequirementVerification @default(AUTOMATIC)

  dueAt     DateTime?
  config    Json      @default("{}")
  sortOrder Int       @default(0)

  outcomes RequirementOutcome[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([requirementTypeId])
}

model EventService {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  serviceTypeId Int
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  /// I18nText { it, en? }
  name        Json
  /// I18nText { it, en? }
  description Json?

  /// Centesimi interi (§3.1).
  price Int @default(0)

  refundCutoffAt DateTime?

  /// Dichiara quali attributi si raccolgono all'acquisto (taglia, dieta, slot).
  /// Diete e allergie sono l'unico dato riconducibile alla salute che resta in
  /// piattaforma: accesso ristretto, mai nelle esportazioni generiche (§4.6).
  attributesConfig Json @default("{}")

  sortOrder Int @default(0)

  orderLines OrderLine[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([serviceTypeId])
}

// -----------------------------------------------------------------------------
// Passo 11 — TicketType (§4.7)
// -----------------------------------------------------------------------------

model TicketType {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// I18nText { it, en? }
  name        Json
  /// I18nText { it, en? }
  description Json?

  /// Centesimi interi (§3.1).
  basePrice Int @default(0)

  saleUnit SaleUnit @default(PER_PERSON)

  /// Vincolo di ruolo del titolo. Incompatibile con `consumesRoleQuota = false` (§4.7).
  roleConstraint    DanceRole?
  consumesRoleQuota Boolean    @default(true)

  saleOpensAt  DateTime?
  saleClosesAt DateTime?

  visibility TicketTypeVisibility @default(PUBLIC)
  accessCode String?

  minPerOrder Int @default(1)
  maxPerOrder Int @default(10)

  indicatedLevel String?
  highlighted    Boolean @default(false)
  sortOrder      Int     @default(0)

  sessions   TicketTypeSession[]
  priceTiers PriceTier[]

  orderLines      OrderLine[]
  passIssuances   PassIssuance[]
  tickets         Ticket[]
  channelMappings SalesChannelMapping[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([accessCode])
}

// -----------------------------------------------------------------------------
// Passo 12 — TicketTypeSession · PriceTier (§4.7) — figli posseduti
// Nessun controller proprio: si scrivono con l'unico PATCH sub-risorsa del §3.4.
// -----------------------------------------------------------------------------

/// Elenco ESPLICITO delle sessioni incluse nel titolo.
model TicketTypeSession {
  id Int @id @default(autoincrement())

  ticketTypeId Int
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  sessionId Int
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticketTypeId, sessionId])
  @@index([sessionId])
}

/// Scaglioni di prezzo. `soldQuantity` è calcolato dal server (§4.7).
model PriceTier {
  id Int @id @default(autoincrement())

  ticketTypeId Int
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  kind PriceTierKind

  /// Centesimi interi (§3.1).
  price Int

  validUntil   DateTime?
  maxQuantity  Int?
  soldQuantity Int       @default(0)
  sortOrder    Int       @default(0)

  orderLines OrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketTypeId])
}

// =============================================================================
// FASE C — Il motore di capienza (backend-brief §4.8 · §4.9 · §4.10,
// allegato tecnico-funzionale `05-modello-capienza.md`)
//
// È il componente più delicato del prodotto: sbaglia in silenzio, sbaglia sotto
// carico, e ogni errore si traduce in una persona che ha pagato e non entra.
// =============================================================================

enum QuotaScope {
  EVENT
  SESSION
  TICKET_TYPE
  SERVICE
}

enum QuotaReservedFor {
  COMPLIMENTARY
  EXTERNAL_CHANNEL
}

enum DeclaredDanceRole {
  LEADER
  FOLLOWER
  FLEXIBLE
}

enum RegistrationStatus {
  CONFIRMED
  TO_CONFIRM
  DECLINED
}

enum RegistrationChannel {
  ONLINE_SALE
  DOOR_SALE
  COMPLIMENTARY
  EXTERNAL_CHANNEL
}

// -----------------------------------------------------------------------------
// Passo 13 — CapacityQuota (§4.8)
// -----------------------------------------------------------------------------

/// Ogni vincolo di capienza è una RIGA DI CONFIGURAZIONE, non un campo sparso su
/// evento e titolo: capienza della sala, equilibrio dei ruoli, inventario
/// commerciale del titolo, capienza di una sala secondaria, impegno con un
/// fornitore. Rende identico il codice che serve una milonga da 120 posti e un
/// encuentro 50+50 con tolleranza (`05` §1).
///
/// `consumed` è un CAMPO CALCOLATO DAL SERVER (§5): nessun DTO di scrittura lo
/// accetta, si muove solo attraverso `CapacityEngineService`.
model CapacityQuota {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  scope QuotaScope

  /// Riferimento POLIMORFO SENZA CHIAVE ESTERNA: punta a `Session`,
  /// `TicketType` o `EventService` secondo `scope` (§4.8). La coerenza è
  /// verificata dal servizio, non dal database.
  scopeId Int?

  /// Nullo = quota totale, indifferente al ruolo. Valorizzabile SOLO su
  /// `scope ∈ {EVENT, SESSION}`: le quote di titolo e di servizio sono per
  /// persona, indipendentemente da come balla.
  role DanceRole?

  /// Tetto assoluto.
  limit Int

  /// Contatore denormalizzato, mosso nella stessa transazione dei consumi con
  /// l'AGGIORNAMENTO CONDIZIONATO del §4.8. Mai scritto dal client.
  consumed Int @default(0)

  /// Se falso la quota CONTA i posti ma NON BLOCCA la vendita (`05` §3): è il
  /// caso delle milonghe incluse in un pass, dove non esiste un posto
  /// assegnato e la sala assorbe.
  limiting Boolean @default(true)

  /// Quota sottratta alla vendita online e non esposta nella disponibilità
  /// pubblica: omaggi (`COMPLIMENTARY`) e biglietteria dell'organizzatore
  /// (`EXTERNAL_CHANNEL`).
  reservedFor QuotaReservedFor?

  /// Valorizzato solo sulle quote di ruolo appaiate del medesimo ambito.
  /// Nullo = nessun cancello. NON estende il limite: restringe dinamicamente
  /// l'accesso al ruolo sovrarappresentato (`05` §6).
  imbalanceTolerance Int?

  /// Posti accettabili oltre il limite senza rifiutare l'ordine.
  /// FORZATO A 0 E NON MODIFICABILE sulla capienza della sala
  /// (`scope=EVENT, role=null`) e sulle quote di ruolo di ambito `EVENT`:
  /// non è un limite commerciale, è un vincolo di sicurezza (`05` §5.1).
  overbookAllowance Int @default(0)

  /// Se falso la disponibilità residua non compare in scheda evento.
  publiclyVisible Boolean @default(true)

  consumptions QuotaConsumption[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Non esistono due quote per la stessa cosa (`05` §2.1).
  ///
  /// SCOSTAMENTO DICHIARATO DAL §3.6 — la terna del brief è
  /// `(eventId, scope, scopeId, role)`, ma il §4.8 indirizza il contingente
  /// degli accrediti come `quota(EVENT, null, reservedFor: COMPLIMENTARY)`:
  /// una quota di ambito EVENT con `scopeId` e `role` nulli, cioè **la stessa
  /// terna della capienza della sala**. Con la terna letterale le due righe
  /// non potrebbero coesistere e il ramo accrediti del §4.8 — con il caso di
  /// test T19 — sarebbe irrealizzabile; lo stesso vale per il contingente
  /// `EXTERNAL_CHANNEL` dell'assunzione AS-4. `reservedFor` entra quindi
  /// nell'identità. Il vincolo resta un SOVRAINSIEME di quello del §3.6:
  /// continua a vietare due quote ordinarie per la stessa cosa.
  @@unique([eventId, scope, scopeId, role, reservedFor])
  @@index([eventId, scope])
}

// -----------------------------------------------------------------------------
// Passo 14 — Couple (§4.10)
// -----------------------------------------------------------------------------

/// NON porta riferimenti alle due iscrizioni: sono le `Registration` a puntare
/// alla coppia con `coupleId`, così il grafo resta aciclico (§3.6).
/// Vincolo di servizio: esattamente due `Registration` con ruoli assegnati
/// complementari. `dissolve` NON muove alcun consumo — le persone restano,
/// cambia solo il legame (`05` §8).
model Couple {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  dissolvedAt DateTime?

  registrations Registration[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// -----------------------------------------------------------------------------
// Passo 15 — Registration (§4.10)
// -----------------------------------------------------------------------------

/// Una iscrizione per persona per evento, con più biglietti collegati.
/// `assignedRole` è CALCOLATO DAL SERVER (§5): il DTO `Update` non lo accetta,
/// la riassegnazione passa dal servizio che rilascia i consumi del vecchio ruolo
/// e impegna quelli del nuovo con le stesse verifiche di un acquisto.
model Registration {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  personUserId Int?
  personUser   User? @relation("RegistrationPerson", fields: [personUserId], references: [id], onDelete: SetNull)

  holderName    String
  holderSurname String
  holderEmail   String

  /// Ciò che l'utente ha scelto.
  declaredRole DeclaredDanceRole
  /// Il ruolo effettivo, risolto alla conferma del pagamento. Mai nullo su
  /// eventi con quote di ruolo (`05` §2.3, invariante I4).
  assignedRole DanceRole?

  channel RegistrationChannel @default(ONLINE_SALE)
  status  RegistrationStatus  @default(TO_CONFIRM)

  confirmedAt DateTime?
  declinedAt  DateTime?

  coupleId Int?
  couple   Couple? @relation(fields: [coupleId], references: [id], onDelete: SetNull)

  isMinor        Boolean @default(false)
  guardianUserId Int?
  guardian       User?   @relation("RegistrationGuardian", fields: [guardianUserId], references: [id], onDelete: SetNull)

  /// La vendita su canale esterno da cui l'iscrizione proviene. Nulla su tutte
  /// le altre — vendita online, porta, accredito.
  externalSaleId Int?
  externalSale   ExternalSale? @relation(fields: [externalSaleId], references: [id], onDelete: SetNull)

  quotaConsumptions   QuotaConsumption[]
  requirementOutcomes RequirementOutcome[]
  tickets             Ticket[]
  checkIns            CheckIn[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Unico su `(eventId, personUserId)` QUANDO `personUserId` non è nullo:
  /// in PostgreSQL un unique index tratta ogni NULL come distinto, quindi le
  /// iscrizioni senza account non si ostacolano fra loro (§3.6).
  @@unique([eventId, personUserId])
  @@index([externalSaleId])
  @@index([eventId, assignedRole])
  @@index([eventId, status])
  @@index([coupleId])
}

// -----------------------------------------------------------------------------
// Passo 16 — QuotaConsumption (§4.9)
// -----------------------------------------------------------------------------

/// Il registro di ciò che ogni iscrizione occupa. È l'elemento che rende il
/// RILASCIO ESATTO anziché ricostruito: si leggono queste righe, si decrementano
/// esattamente quei contatori, si cancellano le righe (`05` §8).
///
/// La chiave unica `(capacityQuotaId, registrationId)` è ciò che rende l'impegno
/// IDEMPOTENTE sulla doppia notifica del prestatore di pagamento (§4.8 nota 3).
model QuotaConsumption {
  id Int @id @default(autoincrement())

  capacityQuotaId Int
  capacityQuota   CapacityQuota @relation(fields: [capacityQuotaId], references: [id], onDelete: Cascade)

  registrationId Int
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([capacityQuotaId, registrationId])
  @@index([registrationId])
}

// =============================================================================
// FASE D1 — Requisiti, biglietti, pass e check-in
// backend-brief §2 passi 17 e 23→26 · §4.10 (RequirementOutcome) · §4.12
// (Ticket, TicketTransfer, PassIssuance) · §4.13 (CheckIn) · `09` §7.
//
// LA REGOLA STRUTTURALE DI TUTTA LA FASE — **l'utilizzo non è uno stato del
// biglietto**. Un Full Pass viene scansionato dodici volte in tre giorni e resta
// `VALID`: il check-in è registrato sulla COPPIA biglietto–sessione, e per gli
// eventi senza sessioni si usa la sessione implicita già creata in fase B
// (`AS-5`). Non esiste, e non deve esistere, uno stato `USED` su `Ticket`.
// =============================================================================

enum RequirementOutcomeStatus {
  TO_PROVIDE
  UNDER_REVIEW
  VALID
  REJECTED
  EXPIRED
}

enum TicketStatus {
  VALID
  TRANSFERRED
  CANCELLED
  REFUNDED
}

enum PassIssuanceReason {
  COMPLIMENTARY
  EXTERNAL_SALE
  GIFT
  COURTESY
}

enum CheckInKind {
  OPERATOR
  MANUAL_SEARCH
  EXTERNAL_ENTRY
}

/// Esito della verifica di `POST /tickets/verify` (§3.5, `RF-CHK-4`).
///
/// NON è una colonna: il check-in non porta un esito, perché una riga di
/// `CheckIn` esiste solo quando l'ingresso è avvenuto. L'enum è dichiarato qui
/// perché il §3.5 lo elenca fra le enumerazioni del contratto e perché così i
/// DTO lo ricevono da `@prisma-gen/zod` come tutti gli altri, da un'unica fonte.
enum CheckInResult {
  VALID
  ALREADY_USED
  WRONG_EVENT
  REFUNDED_OR_CANCELLED
  REQUIREMENT_BLOCKED
}

// -----------------------------------------------------------------------------
// Passo 17 — RequirementOutcome (§4.10)
// -----------------------------------------------------------------------------

/// L'esito di un requisito d'evento su una singola iscrizione.
///
/// `acceptedAt`, `acceptedIp` e `acceptedVersion` sono **calcolati dal server**
/// (`RF-REQ-4`): sono la prova di quando e da dove la persona ha accettato, e un
/// client che li scrivesse renderebbe la prova inutile. Nessun DTO li accetta.
///
/// `value` porta il dato dichiarato (`DECLARATION`) o il campo personalizzato
/// (`CUSTOM_FIELD`). Nel primo taglio non esistono altri generi: nessun upload di
/// documenti, nessun dato sanitario, mai (`RF-REQ-2`, `RF-REQ-3`). Il contenuto
/// di `value` **non compare mai** nella vista di check-in (`RB12`).
model RequirementOutcome {
  id Int @id @default(autoincrement())

  registrationId Int
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  eventRequirementId Int
  eventRequirement   EventRequirement @relation(fields: [eventRequirementId], references: [id], onDelete: Restrict)

  status RequirementOutcomeStatus @default(TO_PROVIDE)
  value  Json                     @default("{}")

  /// Calcolati dal server (`RF-REQ-4`).
  acceptedAt      DateTime?
  acceptedIp      String?
  acceptedVersion String?

  reviewedByUserId Int?
  reviewedBy       User?     @relation("RequirementOutcomeReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  rejectionReason  String?

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([registrationId, eventRequirementId])
  @@index([eventRequirementId])
  @@index([registrationId, status])
}

// -----------------------------------------------------------------------------
// Passi 18→22 — Purchase · Order · OrderLine · Reservation · Payment
//
// GUSCI DICHIARATI, SENZA REPOSITORY NÉ SERVICE NÉ CONTROLLER.
//
// Stripe e il checkout sono rinviati a una fase successiva per decisione del
// committente. Le cinque entità sono però dichiarate qui perché
// `Ticket.orderLineId` è una chiave esterna reale: senza di esse il grafo
// mentirebbe sulla provenienza del biglietto acquistato online, e la fase D2
// dovrebbe migrare una colonna già popolata. La fase D2 riempie questi gusci —
// repository, servizi di prenotazione e pagamento, webhook — senza toccare la
// forma delle tabelle.
// -----------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

/// §3.5. `NONE` = ordine a **importo zero** o **saldato fuori piattaforma**: è il
/// percorso di `POST /orders/:id/confirm-free`, non una scorciatoia per saltare
/// il pagamento. `STRIPE` arriva con la fase D2.
enum PaymentProvider {
  NONE
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReleaseReason {
  EXPIRED
  ABANDONED
  PAYMENT_FAILED
  COMPLETED
}

/// Guscio della fase D2 (§4.11). Raggruppa N `Order`, uno per organizzatore.
model Purchase {
  id Int @id @default(autoincrement())

  buyerUserId Int
  buyer       User @relation("PurchaseBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)

  /// Centesimi interi (§3.1).
  totalAmount        Int @default(0)
  totalPresaleRights Int @default(0)

  orders Order[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerUserId])
}

/// Guscio della fase D2 (§4.11). Un ordine per organizzatore (`RF-PAY-34`).
model Order {
  id Int @id @default(autoincrement())

  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  status OrderStatus @default(PENDING_PAYMENT)

  /// Centesimi interi, tutti calcolati dal server (§4.11).
  subtotal      Int @default(0)
  presaleRights Int @default(0)
  total         Int @default(0)

  priceLockedAt DateTime  @default(now())
  expiresAt     DateTime?
  paidAt        DateTime?
  failedAt      DateTime?
  cancelledAt   DateTime?

  lines        OrderLine[]
  reservations Reservation[]
  payments     Payment[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([organizationId, status])
  @@index([eventId, status])
}

/// Guscio della fase D2 (§4.11). Figlio posseduto: `Cascade` da `Order`, nessun
/// controller proprio (`PATCH /orders/:id/lines`).
model OrderLine {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketTypeId Int?
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)

  eventServiceId Int?
  eventService   EventService? @relation(fields: [eventServiceId], references: [id], onDelete: SetNull)

  quantity Int @default(1)

  /// Centesimi interi, calcolati dal server: un prezzo che arriva dal client è
  /// un difetto di sicurezza (§4.11).
  unitPrice            Int @default(0)
  presaleRightsPerUnit Int @default(0)
  lineTotal            Int @default(0)

  priceTierId Int?
  priceTier   PriceTier? @relation(fields: [priceTierId], references: [id], onDelete: SetNull)

  /// `[{ name, surname, email, declaredRole, serviceAttributes }]`.
  /// `serviceAttributes` può contenere diete e allergie: accesso ristretto,
  /// mai nelle esportazioni generiche né nella vista di check-in (`RB12`).
  attendees Json @default("[]")

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([ticketTypeId])
}

/// Guscio della fase D2 (§4.11). Una sola prenotazione attiva per
/// `(userId, eventId)` — indice unico PARZIALE su `releasedAt IS NULL`, creato a
/// mano nella migrazione (`RF-PAY-23`).
model Reservation {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  userId Int
  user   User @relation("ReservationUser", fields: [userId], references: [id], onDelete: Restrict)

  expiresAt  DateTime
  rearmedAt  DateTime?
  releasedAt DateTime?

  releaseReason ReleaseReason?

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId, eventId])
  @@index([expiresAt])
}

/// Guscio della fase D2 (§4.11). `idempotencyKey` unico e `processedEventIds`
/// sono la difesa contro la doppia notifica di Stripe (`RF-PAY-10`).
model Payment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  provider          PaymentProvider @default(STRIPE)
  providerPaymentId String
  providerAccountId String

  status PaymentStatus @default(PENDING)

  /// Centesimi interi (§3.1).
  amount               Int @default(0)
  applicationFeeAmount Int @default(0)

  idempotencyKey    String   @unique
  processedEventIds String[] @default([])

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
  @@index([providerPaymentId])
}

// -----------------------------------------------------------------------------
// Passo 23 — PassIssuance (§4.12)
// -----------------------------------------------------------------------------

/// Emissione manuale di pass — accrediti, vendite esterne, omaggi, cortesie.
///
/// **Non è mai bloccata dalle quote** (`RB20`, `RF-TCK-14`): si registra il
/// consumo, si restituisce un avviso se si supera la capienza della sala, e si
/// procede. La responsabilità della sala è dell'organizzatore, non della
/// piattaforma, e un blocco qui trasformerebbe uno strumento di servizio in un
/// ostacolo la sera dell'evento.
///
/// `role` è **obbligatorio quando l'evento usa quote per ruolo** (`RF-TCK-15`):
/// senza quel dato l'equilibrio leader/follower mostrato all'organizzatore
/// diventa falso proprio dove serve. Il vincolo è del servizio, non della
/// tabella, perché dipende dalla configurazione dell'evento.
model PassIssuance {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  ticketTypeId Int
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  issuedByUserId Int
  issuedBy       User @relation("PassIssuanceIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)

  quantity Int                @default(1)
  reason   PassIssuanceReason
  role     DanceRole?

  /// Falso = pass **al portatore**, senza nominativo e **non trasferibili**.
  nominal Boolean @default(true)
  note    String?

  issuedAt  DateTime  @default(now())
  revokedAt DateTime?

  tickets Ticket[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, issuedAt])
  @@index([ticketTypeId])
  @@index([issuedByUserId])
}

// -----------------------------------------------------------------------------
// Passo 24 — Ticket (§4.12)
// -----------------------------------------------------------------------------

/// **L'esemplare acquistato**: nominale, trasferibile, con il suo QR (`09` §7).
///
/// Il biglietto è un titolo economico; l'iscrizione è la persona nell'evento con
/// il suo ruolo, i suoi requisiti e i suoi consumi di capienza. Sono due entità
/// distinte e non vanno accorpate: una persona può avere più biglietti e una sola
/// iscrizione.
///
/// ── Il QR (`AS-7`) ───────────────────────────────────────────────────────────
/// Payload firmato **Ed25519** in JWS compatto, con almeno
/// `{ ticketId, eventId, issuedAt, keyId }`. La chiave pubblica è distribuita con
/// il manifest di check-in perché la verifica deve funzionare **senza rete**; il
/// `keyId` esiste per la rotazione. Un QR non firmato è un QR falsificabile con
/// uno screenshot: non esiste una variante «semplificata» del requisito.
/// Il QR è **uno solo per biglietto**, non uno per sessione (`09` §7).
///
/// ── Il PDF (`RF-TCK-11`) ─────────────────────────────────────────────────────
/// `pdfFileId` punta a una **conferma d'ordine con QR di accesso, mai un titolo
/// fiscale**: nessuna numerazione progressiva, nessun sigillo, nessuna dicitura
/// che possa farlo apparire tale. È una delle tre condizioni che reggono il
/// posizionamento fiscale della piattaforma, non una scelta di copywriting.
///
/// ── Ciò che NON c'è, deliberatamente ─────────────────────────────────────────
/// Non esiste uno stato `USED`, e non deve esistere: l'utilizzo è registrato su
/// `CheckIn`, sulla coppia biglietto–sessione (`09` §7, §4.13).
model Ticket {
  id Int @id @default(autoincrement())

  /// Provenienza: riga d'ordine (vendita online) **oppure** emissione manuale.
  /// Entrambe nullable e `SetNull`: un biglietto non sparisce né perde validità
  /// perché l'ordine da cui nasce viene riorganizzato.
  orderLineId Int?
  orderLine   OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)

  passIssuanceId Int?
  passIssuance   PassIssuance? @relation(fields: [passIssuanceId], references: [id], onDelete: SetNull)

  /// La terza provenienza: la vendita dichiarata da un negozio esterno.
  externalSaleId Int?
  externalSale   ExternalSale? @relation(fields: [externalSaleId], references: [id], onDelete: SetNull)

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  ticketTypeId Int
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  /// L'iscrizione a cui il biglietto dà corpo. Nulla sui pass al portatore, che
  /// non hanno una persona finché qualcuno non si presenta.
  registrationId Int?
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  /// Il contenuto del QR firmato. Unico e indicizzato: è la chiave di ricerca
  /// di `POST /tickets/verify`.
  code String @unique

  status TicketStatus @default(VALID)

  holderName    String
  holderSurname String
  holderEmail   String?

  /// Pass emesso in blocco senza nominativo: **al portatore, non trasferibile**.
  bearer Boolean @default(false)

  qrIssuedAt  DateTime  @default(now())
  /// Valorizzato quando il QR è invalidato definitivamente (rimborso,
  /// annullamento). Il TRASFERIMENTO non lo valorizza: emette un `code` nuovo,
  /// e il precedente muore perché non corrisponde più ad alcun biglietto —
  /// resta su `TicketTransfer.previousCode` come traccia storica.
  qrRevokedAt DateTime?

  pdfFileId Int?
  pdfFile   File? @relation("TicketPdf", fields: [pdfFileId], references: [id], onDelete: SetNull)

  transfers TicketTransfer[]
  checkIns  CheckIn[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([code])
  @@index([registrationId])
  @@index([ticketTypeId])
  @@index([passIssuanceId])
  @@index([orderLineId])
  @@index([externalSaleId])
}

// -----------------------------------------------------------------------------
// Passo 25 — TicketTransfer (§4.12)
// -----------------------------------------------------------------------------

/// Storico completo dei passaggi di titolarità — **sola lettura via API**: si
/// crea soltanto attraverso `POST /tickets/:id/transfer` (§3.4).
///
/// `fromHolder` e `toHolder` sono fotografie del nominativo al momento del
/// passaggio: restano leggibili anche se l'utente collegato viene poi cancellato,
/// ed è la ragione per cui non sono ricostruite dalle chiavi esterne.
model TicketTransfer {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fromUserId Int?
  fromUser   User? @relation("TicketTransferFrom", fields: [fromUserId], references: [id], onDelete: SetNull)

  toUserId Int?
  toUser   User? @relation("TicketTransferTo", fields: [toUserId], references: [id], onDelete: SetNull)

  /// `{ name, surname, email? }`
  fromHolder Json
  toHolder   Json

  /// Il `code` invalidato dal passaggio: da qui in poi non apre più nulla.
  previousCode String

  transferredAt DateTime @default(now())

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, transferredAt])
  @@index([fromUserId])
  @@index([toUserId])
}

// -----------------------------------------------------------------------------
// Passo 26 — CheckIn (§4.13)
// -----------------------------------------------------------------------------

/// L'accesso a **una singola sessione**, registrato sulla coppia
/// biglietto–sessione (`09` §7).
///
/// ── `RB7` ────────────────────────────────────────────────────────────────────
/// Indice unico **parziale** su `(ticketId, sessionId)` quando `revokedAt` è
/// nullo: *un QR vale una sola volta per sessione*. Prisma non sa esprimere un
/// indice parziale, quindi `@@unique` qui sotto è ricreato a mano nella
/// migrazione con la clausola `WHERE`.
///
/// ── `RB19` ───────────────────────────────────────────────────────────────────
/// **Il check-in non consuma capienza.** Le quote governano l'ammissione, il
/// contatore presenze governa la sicurezza: sono due assi distinti e questo
/// modello non ha alcuna relazione con `CapacityQuota`.
///
/// ── `RF-CHK-6` ───────────────────────────────────────────────────────────────
/// `conflictWithId` punta all'ingresso già registrato quando la sincronizzazione
/// della coda offline rileva un doppio ingresso. La seconda riga **viene creata e
/// lasciata allo staff**: i doppi ingressi sono conflitti da risolvere, mai
/// risolti in silenzio.
model CheckIn {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  sessionId Int
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  registrationId Int
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  operatorUserId Int
  operator       User @relation("CheckInOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)

  kind CheckInKind @default(OPERATOR)

  /// Momento della scansione **sul dispositivo**: offline può precedere di ore
  /// la sincronizzazione, ed è questo il momento che vale come ingresso.
  scannedAt DateTime  @default(now())
  /// Momento in cui la riga è arrivata al server. Nullo sugli ingressi online.
  syncedAt  DateTime?

  /// La «postazione» che `RF-CHK-4` chiede di nominare su `ALREADY_USED`.
  deviceId String
  offline  Boolean @default(false)

  conflictWithId Int?
  conflictWith   CheckIn?  @relation("CheckInConflict", fields: [conflictWithId], references: [id], onDelete: SetNull)
  conflicts      CheckIn[] @relation("CheckInConflict")

  /// Annullamento di un check-in errato (`RF-CHK-9`). Una riga revocata esce
  /// dall'indice parziale: il biglietto può rientrare in quella sessione.
  revokedAt DateTime?

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ricreato a mano nella migrazione come indice PARZIALE — vedi sopra.
  @@unique([ticketId, sessionId])
  @@index([sessionId, scannedAt])
  @@index([deviceId])
  @@index([registrationId])
  @@index([conflictWithId])
}

// =============================================================================
// FASE E — I canali di vendita esterni
//
// L'organizzatore che arriva su Mirada ha spesso già un negozio suo — Shopify,
// WooCommerce, altro — e non lo smonta il giorno in cui si iscrive. Questa
// sezione è ciò che permette a quel negozio di **dichiarare le proprie vendite**
// invece di lasciarle digitare a mano.
//
// ── Non è un concetto nuovo: è l'automazione di una riga già scritta ─────────
// `05-modello-capienza.md` §5 dichiara da sempre il canale esterno: non
// bloccante, gestione facoltativa per evento, «registrazione manuale delle
// quantità». `RegistrationChannel.EXTERNAL_CHANNEL` e
// `QuotaReservedFor.EXTERNAL_CHANNEL` esistono già. Qui cambia **soltanto** chi
// preme il tasto: il webhook del negozio al posto dell'organizzatore.
//
// ── Chi possiede la capienza ────────────────────────────────────────────────
// Il negozio esterno. L'organizzatore gli riserva un contingente con una quota
// `reservedFor = EXTERNAL_CHANNEL` — che `CapacityEngineService.availability()`
// già sottrae alla vendita online e alla disponibilità pubblica — e il negozio
// vende contro quel contingente col proprio inventario. **Un contatore per
// canale**: nessuna sincronizzazione bidirezionale, nessun doppio impegno.
//
// ── La regola che governa tutta l'ingestione ────────────────────────────────
// **Una vendita già incassata non può essere rifiutata.** Il denaro si è mosso
// altrove e Mirada non può disfarlo: l'impegno passa da `commitWithoutBlocking`
// (`RB20`, la stessa strada dell'emissione manuale di pass), che registra il
// consumo, avvisa se sfora e procede. L'invariante `I1` del `05` lo dice già:
// il consumo che viene dai canali esterni **può** eccedere il limite, ed è
// informativo e sotto la responsabilità dell'organizzatore.
//
// ── Nessun `Order`, nessun `Payment` ────────────────────────────────────────
// Il denaro non è mai passato da Mirada: scrivere una riga `Payment` per una
// vendita Shopify sarebbe una bugia nel registro degli incassi, e romperebbe il
// significato di `Payment.idempotencyKey`. La vendita esterna ha una propria
// idempotenza — `@@unique([salesChannelId, externalOrderId])` — e un proprio
// registro. `Ticket` porta già due provenienze nullable («riga d'ordine oppure
// emissione manuale»): questa è la terza.
// =============================================================================

enum SalesChannelProvider {
  SHOPIFY
}

enum SalesChannelStatus {
  /// Riceve notifiche e ingerisce.
  ACTIVE
  /// Riceve e **registra** le notifiche, ma non ingerisce. Serve a fermare
  /// l'ingestione senza perdere le vendite che arrivano nel frattempo: se il
  /// canale rifiutasse le notifiche, il prestatore le riproverebbe per qualche
  /// ora e poi le butterebbe.
  PAUSED
  /// Disconnesso. Le notifiche sono rifiutate.
  DISABLED
}

/// Il negozio esterno collegato a un'organizzazione.
///
/// ── Le credenziali sono un JSON cifrato, non tre colonne Shopify ────────────
/// Oggi Trani usa un'app *custom* del proprio negozio: un token statico. Il
/// secondo organizzatore su Shopify richiederà un'app pubblica con OAuth, e il
/// terzo sarà su WooCommerce. Se le credenziali fossero colonne dedicate, ogni
/// prestatore nuovo sarebbe una migrazione; essendo una busta cifrata, è una
/// riga di configurazione. Il contenuto lo interpreta l'adapter del prestatore,
/// che è l'unico che sa cosa significa.
model SalesChannel {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  provider SalesChannelProvider

  /// Nome dato dall'organizzatore — è ciò che legge nel back-office.
  label String

  /// Il segmento in URL del webhook (`/api/sales-channels/webhook/:publicId`).
  /// Opaco e generato dal server: l'id numerico in un URL pubblico direbbe a
  /// chiunque quanti canali esistono e permetterebbe di provarli a uno a uno.
  publicId String @unique

  /// Identificativo del negozio presso il prestatore — per Shopify il dominio
  /// `qualcosa.myshopify.com`. Unico per prestatore: lo stesso negozio non può
  /// essere collegato a due organizzazioni, che sarebbe il modo di far comparire
  /// le vendite di uno nel cruscotto dell'altro.
  externalShopId String

  /// Busta cifrata (AES-256-GCM, `@utils/adapters/secretBox`). Mai in chiaro:
  /// un token di amministrazione Shopify legge ordini e anagrafiche di TUTTO il
  /// negozio, non solo dei biglietti.
  credentials String?

  /// Segreto con cui il prestatore firma le notifiche. Cifrato come sopra.
  webhookSecret String

  status SalesChannelStatus @default(ACTIVE)

  /// Fin dove è arrivata l'ultima passata di riconciliazione. È il `updated_at_min`
  /// della chiamata successiva: senza, la riconciliazione rileggerebbe ogni volta
  /// tutto lo storico del negozio.
  lastReconciledAt DateTime?

  mappings SalesChannelMapping[]
  sales    ExternalSale[]
  events   ExternalSaleEvent[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalShopId])
  @@index([organizationId])
}

/// La traduzione: prodotto del negozio → titolo d'ingresso di Mirada.
///
/// ── `externalVariantId` è `""`, non `NULL` ──────────────────────────────────
/// In PostgreSQL un indice univoco tratta ogni `NULL` come distinto: con la
/// variante nullable si potrebbero creare **due** mappature «qualunque variante»
/// per lo stesso prodotto, e la risoluzione diventerebbe casuale. La stringa
/// vuota significa «qualunque variante» ed è un valore come gli altri, quindi il
/// vincolo di unicità funziona davvero.
///
/// La risoluzione prova prima la variante esatta, poi il ripiego su `""`.
model SalesChannelMapping {
  id Int @id @default(autoincrement())

  salesChannelId Int
  salesChannel   SalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Cascade)

  externalProductId String
  /// `""` = qualunque variante del prodotto. Vedi la nota sopra.
  externalVariantId String @default("")

  /// **Nullo di proposito**: una mappatura senza titolo significa «questo
  /// articolo non è un biglietto, ignoralo». Serve al caso normale del negozio
  /// che vende anche magliette e libri: senza, un ordine misto finirebbe in
  /// quarantena a ogni acquisto, e la quarantena smetterebbe di voler dire
  /// «qualcosa non va».
  ///
  /// La distinzione che conta è fra **nessuna mappatura** — non so cosa sia,
  /// quarantena — e **mappatura senza titolo** — so cos'è, non è un biglietto.
  ticketTypeId Int?
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  /// Quanti posti vale una unità di questo prodotto. Un «pacchetto coppia»
  /// venduto come un articolo solo ne vale due, e senza questo campo entrerebbe
  /// in sala una persona sola con due biglietti in tasca.
  seatsPerUnit Int @default(1)

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salesChannelId, externalProductId, externalVariantId])
  @@index([ticketTypeId])
}

enum ExternalSaleStatus {
  /// Notifica ricevuta e firmata, non ancora elaborata.
  RECEIVED
  /// Iscrizioni create, capienza impegnata, biglietti emessi.
  INGESTED
  /// Non si sa tradurla: prodotto non mappato, evento non pubblicato, titolo
  /// cancellato. **Attende una mano umana e non si perde.**
  QUARANTINED
  /// Rimborsata o annullata presso il prestatore: capienza rilasciata, biglietti
  /// invalidati.
  REFUNDED
  /// L'elaborazione è fallita per una ragione tecnica. Il cron ritenta.
  FAILED
}

/// La vendita, nella forma che Mirada capisce.
///
/// È il **modello canonico**: qui non c'è nulla di Shopify. L'adapter del
/// prestatore riempie questa riga, e tutto ciò che sta a valle — iscrizioni,
/// capienza, biglietti, WebSocket — non sa da quale negozio sia arrivata. È la
/// stessa forma di `SettlementFact` in `OrderFulfilmentService`, e per la stessa
/// ragione: il giorno di WooCommerce si scrive un adapter, non un percorso.
model ExternalSale {
  id Int @id @default(autoincrement())

  salesChannelId Int
  salesChannel   SalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)

  /// Risolto dalla mappatura delle righe. **Nullo in quarantena**: se non si sa
  /// tradurre il prodotto non si sa nemmeno di quale evento si parli.
  eventId Int?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)

  /// L'ordine presso il prestatore. Unico per canale: **è l'idempotenza**. La
  /// stessa notifica consegnata due volte — cosa che i webhook fanno per
  /// progetto — trova un conflitto di chiave invece di emettere altri biglietti.
  externalOrderId     String
  /// Il numero che l'organizzatore legge sul suo negozio (`#1042`). Serve a lui,
  /// non al codice: è come si ritrova un ordine quando qualcuno telefona.
  externalOrderNumber String?

  status ExternalSaleStatus @default(RECEIVED)

  buyerName    String
  buyerSurname String
  buyerEmail   String

  /// Centesimi interi, come ovunque nel dominio (§3.1). È l'importo incassato
  /// **dal negozio**, non da Mirada: serve a riconciliare, non a contabilizzare.
  totalAmount Int    @default(0)
  currency    String @default("EUR")

  /// La vendita nella forma **canonica** — l'esito della traduzione, non il corpo
  /// che è arrivato. Il corpo grezzo esiste e sta su `ExternalSaleEvent.payload`:
  /// qui serve altro, cioè ciò che `ingest` sa già consumare.
  ///
  /// È ciò che rende possibile rielaborare una quarantena dopo aver corretto la
  /// mappatura **senza chiedere di nuovo l'ordine al negozio** — e quindi senza
  /// dipendere dal fatto che il negozio risponda, che è precisamente ciò su cui
  /// non si può contare nel momento in cui serve.
  canonicalPayload Json

  /// Perché è in quarantena, in italiano e leggibile: è il testo che
  /// l'organizzatore vede accanto al pulsante per rimediare.
  quarantineReason String?

  receivedAt DateTime  @default(now())
  ingestedAt DateTime?
  refundedAt DateTime?

  registrations Registration[]
  tickets       Ticket[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salesChannelId, externalOrderId])
  @@index([salesChannelId, status])
  @@index([eventId])
  @@index([buyerEmail])
}

enum ExternalSaleEventStatus {
  RECEIVED
  PROCESSED
  /// Notifica valida ma senza conseguenze — un argomento che non ci interessa.
  IGNORED
  FAILED
}

/// Il registro grezzo delle notifiche ricevute.
///
/// Sembra un doppione di `ExternalSale` e non lo è: questa tabella registra
/// **ciò che è arrivato**, quella registra **ciò che ne abbiamo capito**. Serve a
/// tre cose che senza di essa non si possono fare: rispondere `200` al prestatore
/// prima di aver elaborato (Shopify stacca a 5 secondi), ritentare ciò che è
/// fallito, e ricostruire cosa è successo quando l'organizzatore dice «io
/// quell'ordine l'ho visto».
model ExternalSaleEvent {
  id Int @id @default(autoincrement())

  salesChannelId Int
  salesChannel   SalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Cascade)

  /// L'identificativo della **consegna** presso il prestatore
  /// (`X-Shopify-Webhook-Id`). Unico per canale: la stessa consegna ripetuta non
  /// viene rielaborata. Distinto da `externalOrderId`, perché lo stesso ordine
  /// genera più notifiche legittime (pagato, poi rimborsato).
  externalEventId String

  /// L'argomento presso il prestatore — `orders/paid`, `refunds/create`, …
  topic String

  externalOrderId String?

  payload Json

  status ExternalSaleEventStatus @default(RECEIVED)
  /// Il messaggio dell'errore, quando `FAILED`. È ciò che si legge prima di
  /// decidere se ritentare o correggere.
  error  String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salesChannelId, externalEventId])
  @@index([salesChannelId, status])
  @@index([externalOrderId])
}
