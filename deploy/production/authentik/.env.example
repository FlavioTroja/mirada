# Configurazione di Authentik. Sul server questo file è
# /home/manager/orch/authentik/.env e NON è in questo repository: contiene
# segreti. Questo è il modello da copiare.
#
#   cp .env.example .env    e poi riempi ogni riga marcata «GENERA» o «SEGRETO»

# ── Versione ─────────────────────────────────────────────────────────────────
# Fissata di proposito, mai `latest`: gli aggiornamenti maggiori di Authentik
# migrano il database e non si torna indietro. Si alza a mano, dopo aver letto
# le note di rilascio, e con un dump fresco.
AUTHENTIK_TAG=2026.5.6

TZ=Europe/Rome

# ── PostgreSQL dedicato ──────────────────────────────────────────────────────
PG_DB=authentik
PG_USER=authentik
# GENERA:  openssl rand -base64 36 | tr -d '\n=+/' | cut -c1-40
PG_PASS=

# ── Chiave segreta ───────────────────────────────────────────────────────────
# Firma i cookie di sessione e cifra i segreti conservati in banca dati.
# ⚠️ Cambiarla invalida ogni sessione E rende illeggibili i segreti già salvati
# (per esempio il client secret di Google): si genera UNA volta e si conserva.
# GENERA:  openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# ── Amministratore iniziale ──────────────────────────────────────────────────
# Con queste tre righe l'utenza `akadmin` nasce già pronta al primo avvio e si
# salta la procedura guidata nel browser. Vengono lette SOLO alla prima
# migrazione del database: cambiarle dopo non ha alcun effetto, la password si
# cambia dall'interfaccia.
AUTHENTIK_BOOTSTRAP_EMAIL=
# GENERA:  openssl rand -base64 30 | tr -d '\n=+/'
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Token dell'API con cui configurare provider e applicazioni senza passare dal
# browser. GENERA:  openssl rand -hex 32
AUTHENTIK_BOOTSTRAP_TOKEN=

# ── Posta ────────────────────────────────────────────────────────────────────
# Stessa casella OVH del backend di mirada (vedi ~/orch/mirada/production/backend/.env).
# Sulla 465 il TLS è implicito: USE_SSL sì, USE_TLS no. Accenderli entrambi è
# l'errore classico e produce un handshake che non finisce mai.
AUTHENTIK_EMAIL__HOST=ssl0.ovh.net
AUTHENTIK_EMAIL__PORT=465
AUTHENTIK_EMAIL__USE_SSL=true
AUTHENTIK_EMAIL__USE_TLS=false
AUTHENTIK_EMAIL__USERNAME=
# SEGRETO: la stessa di SMTP_PASSWORD nel .env del backend.
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__FROM=
AUTHENTIK_EMAIL__TIMEOUT=15

# ── Rumore in meno ───────────────────────────────────────────────────────────
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true
AUTHENTIK_LOG_LEVEL=info
