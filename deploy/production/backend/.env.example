# ─────────────────────────────────────────────────────────────────────────────
# Mirada — produzione: MODELLO del .env DEL BACKEND
# ─────────────────────────────────────────────────────────────────────────────
#
# Questo file arriva al container INTERO, con `env_file:`. Il compose non lo
# legge e non lo interpola.
#
# ⚠️ `env_file` NON CONTROLLA NIENTE. Le variabili del compose hanno default
# (`${VAR:-…}`) e obbligatorietà (`${VAR:?…}`, che fa fallire `config`
# nominando la variabile). Quelle di questo file no: Compose passa quel che
# trova e TACE su quel che manca. Una variabile omessa qui non blocca l'avvio —
# fa comportare il backend in un modo che nessuno ha deciso. Tenere il file
# COMPLETO, e tenere questo modello allineato.
#
# NON mettere qui: NODE_ENV, HOST, PORT, DATABASE_URL, TZ, TIMEZONE. Le fissa
# il blocco `environment:` del compose, che VINCE su `env_file`: scriverle qui
# darebbe l'impressione di poterle cambiare, e non si potrebbe.
#
#     cp .env.example .env && chmod 600 .env && nano .env
# ─────────────────────────────────────────────────────────────────────────────


# ── Autenticazione ───────────────────────────────────────────────────────────
# Cambiarlo invalida TUTTE le sessioni in corso: dopo un cambio, ogni utente
# collegato riceve 401 al primo richiamo. È normale, ed è bene saperlo prima.
#
#     openssl rand -base64 48
JWT_SECRET=CAMBIAMI-segreto-jwt

# Costo del bcrypt. 12 è il valore usato in sviluppo e in staging: cambiarlo
# non invalida le password esistenti (il costo è dentro ogni hash), ma
# rallenta o accelera ogni login da qui in avanti.
SALT_ROUNDS=12


# ── L'utenza di servizio ─────────────────────────────────────────────────────
# Alla prima apertura esistono SOLO le utenze del seed. Si entra con queste e
# da lì si creano gli utenti veri.
#
# ⚠️ Cambiare GOD_PASSWORD qui DOPO il primo avvio non ha effetto: il seed
# salta l'intero blocco utenti se ne esiste già almeno uno. La password si
# cambia dall'applicazione.
GOD_USERNAME=god
GOD_PASSWORD=CAMBIAMI-password-god

# Idempotente (upsert): ruoli, permessi e utenti di servizio. Va lasciato a
# `true`: a ogni avvio riallinea i permessi introdotti da una versione nuova.
SEED_DB=true


# ── Gli indirizzi pubblici ───────────────────────────────────────────────────
# Sono DUE variabili distinte con due usi distinti, e confonderle produce
# guasti che non si somigliano.
#
# DOMAIN_URL — la base degli URL dei FILE che il backend genera:
#   locandine (/images), biglietti (/tickets), ricevute (/receipts),
#   export (/exports). Quegli URL finiscono dentro PDF ed email, cioè in posti
#   che non si possono correggere dopo. Deve essere l'origine pubblica su cui
#   quei percorsi rispondono davvero — qui li serve il container `files`,
#   instradato dal proxy sotto ENTRAMBI i domini.
DOMAIN_URL=https://mirada.dance
#
# PUBLIC_URL — la base dei LINK nelle email (conferma iscrizione, layout dei
# messaggi). Punta al sito pubblico, dove il ballerino deve atterrare.
# Il codice ripiega su https://mirada.dance se manca; scriverla comunque, così
# la configurazione non dipende da un default nascosto in un sorgente.
PUBLIC_URL=https://mirada.dance


# ── Posta ────────────────────────────────────────────────────────────────────
# ⚠️ QUESTA È LA VARIABILE PIÙ PERICOLOSA DEL FILE.
#
# Senza `SMTP_HOST` il backend NON spedisce e NON fallisce: scrive il messaggio
# nel log e prosegue come se avesse spedito (`src/mail/adapters/SmtpMailer.ts`).
# In produzione significa iscrizioni che non ricevono mai la conferma, biglietti
# che non arrivano, e nessun errore da nessuna parte — il guasto si manifesta
# come «i ballerini si lamentano», giorni dopo.
#
# Verifica dopo averlo compilato:
#   docker compose logs backend | grep -i "smtp"
# La riga «SMTP_HOST is not set — mail will be logged and NOT delivered» è il
# sintomo. Se c'è, la posta non parte.
SMTP_HOST=CAMBIAMI-smtp.esempio.it
SMTP_PORT=587
SMTP_USER=CAMBIAMI-utente-smtp
SMTP_PASSWORD=CAMBIAMI-password-smtp
# Lasciare vuoto o `false` per la 587 (STARTTLS, il caso normale: il transport
# parte in chiaro e sale a TLS). `true` solo per la 465, che è TLS dall'inizio.
SMTP_SECURE=false

# Mittente. `MAIL_FROM` deve appartenere a un dominio che l'SMTP è autorizzato
# a usare, altrimenti SPF/DMARC fanno finire tutto nello spam — e anche questo
# non produce errori visibili da qui.
MAIL_FROM=biglietti@mail.mirada.dance
MAIL_FROM_NAME=Mirada


# ── Firma dei QR dei biglietti ───────────────────────────────────────────────
# backend-brief §4.12, assunzione AS-7. Chiave privata Ed25519 in PKCS#8 DER,
# codificata base64, su UNA riga:
#
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
#
# ⚠️ In assenza il backend ne genera una EFFIMERA all'avvio e lo dichiara nel
# log: i QR emessi NON sopravvivono al riavvio del processo. Cioè i biglietti
# venduti oggi diventano non verificabili al primo redeploy. «Accettabile in
# sviluppo, mai in produzione» — e questa è la produzione.
#
# ⚠️ E una volta emessi dei biglietti, questa chiave NON si cambia più senza
# spostare la vecchia in QR_SIGNING_RETIRED_KEYS: i QR già in mano ai ballerini
# sono firmati con quella.
QR_SIGNING_KEY_ID=CAMBIAMI-identificativo-chiave
QR_SIGNING_PRIVATE_KEY=CAMBIAMI-chiave-ed25519-base64
# Chiavi ritirate, ancora accettate in verifica. Vuoto finché non se ne ruota una.
QR_SIGNING_RETIRED_KEYS=


# ── WebSocket ────────────────────────────────────────────────────────────────
# Identifica la sorgente nelle buste degli eventi in tempo reale. Il codice
# ripiega su "backoffice"; su una sola istanza il valore non cambia nulla, e
# conterà quando le istanze saranno più d'una.
WS_SOURCE_ID=production


# ── Integrazioni ─────────────────────────────────────────────────────────────
# Volutamente vuota. Il template `@keijo/create-be@0.2.5` la spediva valorizzata
# con una chiave reale: va ruotata a monte, non riusata.
GOOGLE_API_KEY=
