# ─────────────────────────────────────────────────────────────────────────────
# Mirada — produzione: MODELLO del .env del BACKUP NOTTURNO su S3
# ─────────────────────────────────────────────────────────────────────────────
#
# ⚠️ Il servizio `backup` è dichiarato nel compose sotto `profiles: ["backup"]`,
# cioè NON parte con un `docker compose up -d` normale. È spento di proposito
# finché queste credenziali non sono vere: un container che tenta ogni notte di
# scrivere su un bucket che non esiste produce log di errore che nessuno legge
# e la falsa impressione che il backup ci sia.
#
# Per accenderlo, una volta compilato questo file:
#
#     docker compose --profile backup up -d backup
#
# e da quel momento va incluso in ogni comando che lo riguarda (il profilo non
# si "ricorda": `docker compose ps` senza `--profile backup` non lo mostra).
#
#     cp .env.example .env && chmod 600 .env && nano .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Accesso al database ──────────────────────────────────────────────────────
# PGHOST, PGPORT e PGDATABASE li fissa il compose. Qui servono le credenziali.
#
# ⚠️ Va usata un'utenza in SOLA LETTURA, non quella del backend: il backup non
# ha alcun motivo di poter scrivere, e un'utenza che può scrivere è un modo in
# più di perdere i dati che sta salvando. Si crea così, dal container del db:
#
#   docker compose exec db psql -U <POSTGRES_USER> -d <POSTGRES_DB> -c \
#     "CREATE ROLE backup LOGIN PASSWORD '<password>'; \
#      GRANT CONNECT ON DATABASE <db> TO backup; \
#      GRANT USAGE ON SCHEMA public TO backup; \
#      GRANT SELECT ON ALL TABLES IN SCHEMA public TO backup; \
#      ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO backup;"
#
# L'ultima riga NON è opzionale: senza, le tabelle create dalle migrazioni
# FUTURE non sarebbero leggibili, e il dump uscirebbe incompleto senza fallire.
PGUSER=backup
PGPASSWORD=CAMBIAMI-password-utenza-backup

# ── Destinazione S3 ──────────────────────────────────────────────────────────
S3_ENDPOINT=CAMBIAMI-https://s3.esempio.it
S3_BUCKET=CAMBIAMI-nome-bucket
S3_REGION=CAMBIAMI-regione
S3_ACCESS_KEY=CAMBIAMI-access-key
S3_SECRET_KEY=CAMBIAMI-secret-key
# Sottocartella dentro il bucket. Tenere gli ambienti separati è ciò che
# impedisce a un ripristino di pescare il dump sbagliato.
S3_PATH=mirada/production

# ── Quando, e per quanto ─────────────────────────────────────────────────────
# Orario del container, che il compose fissa a Europe/Rome.
BACKUP_CRON=30 3 * * *
# Giorni di conservazione. Oltre, i dump vecchi vengono rimossi.
BACKUP_RETENTION_DAYS=30
