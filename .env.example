# Mirada Tango — variabili dello stack docker compose alla radice.
# Copia in `.env` e valorizza. Il file `.env` NON va versionato.
#
#   cp .env.example .env
#   sed -i "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -hex 32)|" .env
#
# Nota: questo file configura i CONTAINER. Il backend eseguito sull'host in
# sviluppo legge invece `backend/.env`, che resta separato.

# --- Database -----------------------------------------------------------
DB_USER=mirada
DB_PASSWORD=mirada
DB_NAME=mirada
# 5442 e non 5432: su questa macchina la 5432 è occupata da un altro stack.
DB_PORT=5442

# --- Redis --------------------------------------------------------------
REDIS_PORT=6379

# --- API ----------------------------------------------------------------
API_PORT=5000
DOMAIN_URL=http://localhost:5000

# --- Segreti — obbligatori, senza default ------------------------------
# Il compose si rifiuta di avviarsi se questi due sono vuoti.
JWT_SECRET=
GOD_USERNAME=god
GOD_PASSWORD=

# --- Seed ---------------------------------------------------------------
# Idempotente (upsert): ruoli, permessi e utenti di servizio.
SEED_DB=true

# --- Integrazioni --------------------------------------------------------
# Volutamente vuota. Il template `@keijo/create-be@0.2.5` la spediva
# valorizzata con una chiave reale: va ruotata e rimossa a monte.
GOOGLE_API_KEY=
